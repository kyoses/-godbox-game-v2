<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/silk_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="许昌"
            android:textColor="@color/ink_red"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRegion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="豫州"
            android:textColor="@color/ink_cyan"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp"
            android:padding="16dp"
            android:background="@color/silk_bg">

            <TextView
                android:id="@+id/tvTroops"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="兵力：8000"
                android:textColor="@color/ink_black"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvMorale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="民心：85"
                android:textColor="@color/ink_black"
                android:textSize="18sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvTax"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="税收：1600"
                android:textColor="@color/ink_black"
                android:textSize="18sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvGovernor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="太守：张辽"
                android:textColor="@color/ink_gold"
                android:textSize="18sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="内政"
            android:textColor="@color/ink_red"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/btnTaxUp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="增税 (+500金 / -5民心)"
            android:textColor="@color/silk_bg"
            android:background="@drawable/btn_round_red" />

        <Button
            android:id="@+id/btnRelief"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="赈灾 (-500金 / +10民心)"
            android:textColor="@color/ink_gold"
            android:background="@drawable/btn_round_gold" />

        <Button
            android:id="@+id/btnRecruit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="募兵 (-1000金 / +1000兵)"
            android:textColor="@color/ink_gold"
            android:background="@drawable/btn_round_gold" />

        <Button
            android:id="@+id/btnChangeGov"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="更换太守"
            android:textColor="@color/silk_bg"
            android:background="@drawable/btn_round_red" />

        <LinearLayout
            android:id="@+id/ministerList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>